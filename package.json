{
  "name": "travelora-workspace",
  "version": "1.0.0",
  "description": "TRAVELORA — Smart Travel Booking System",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "client:build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["travel", "booking", "react", "express", "tailwind"],
  "author": "Travelora Team",
  "license": "ISC"
}
